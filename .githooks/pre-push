#!/bin/sh

# exit when any command fails
set -e

echo "🚀 Running pre-push checks..."

# Run Prettier check on Solidity files
echo "💅 Checking Solidity formatting..."
npx prettier --check 'contracts/**/*.sol' --config .prettierrc.json --end-of-line auto

# Run tests to ensure everything works
echo "🧪 Running tests..."
yarn test

# Compile contracts with Foundry to update out directory
echo "🔨 Compiling contracts with Foundry..."
forge build

# Generate documentation 
echo "📚 Generating documentation for Solidity contracts..."
yarn doc

# Check if docs directory exists and has changes
if [ -d "./docs" ]; then
    echo "📝 Adding generated documentation to staging..."
    git add docs/
    
    # Check if there are changes to commit
    if ! git diff --cached --quiet; then
        echo "📝 Committing generated documentation..."
        git commit -m "docs: update generated documentation"
    else
        echo "ℹ️  No documentation changes to commit"
    fi
else
    echo "ℹ️  No docs directory found"
fi

# Clean out directory to remove non-major artifacts
echo "🧹 Cleaning out directory..."
yarn clean:out

echo "✅ All pre-push checks passed!"
echo "🚀 Ready to push!"

exit 0 