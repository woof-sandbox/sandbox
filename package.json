{
  "name": "sandbox",
  "version": "0.1.0",
  "description": "",
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./*": "./dist/*.js"
  },
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "dist/index.d.ts": [
        "dist/index.d.ts"
      ],
      "*": [
        "dist/*"
      ]
    }
  },
  "scripts": {
    "preinstall": "git submodule update --init --recursive",
    "postinstall": "yarn setup:hooks",
    "build": "hardhat compile",
    "clean": "hardhat clean && rm -rf build/ cache/ coverage* dist/",
    "test": "hardhat test",
    "test:coverage": "hardhat coverage",
    "slither": "yarn clean && yarn build && slither contracts/ --hardhat-ignore-compile --checklist > SLITHER_REPORT.md",
    "lint:ts": "eslint --no-error-on-unmatched-pattern scripts/**/*.ts test/**/*.ts hardhat.config.ts",
    "lint:sol": "solhint contracts/**/*.sol contracts/*.sol --config .solhint.json",
    "aderyn": "npx aderyn --src contracts/ -o ADERYN_REPORT.md",
    "prettier:sol": "prettier --write contracts/**/*.sol --config .prettierrc.json  --end-of-line auto",
    "prettier:ts": "prettier --no-error-on-unmatched-pattern --write test/**/*.ts src/**/*.ts scripts/**/*.ts hardhat.config.ts --config .prettierrc.json  --end-of-line auto",
    "doc": "hardhat docgen",
    "clean:out": "./scripts/clean-out.sh",
    "setup:hooks": "git config core.hooksPath .githooks",
    "load-env": "source .env",
    "sepolia:deploy:fauceteer": "source .env && forge script script/sepolia/DeployFauceteer.s.sol --rpc-url $SEPOLIA_RPC_URL --verify --etherscan-api-key $ETHERSCAN_KEY --broadcast -vvvv",
    "sepolia:distribute-tokens": "source .env && forge script script/sepolia/DistributeTokens.s.sol --rpc-url $SEPOLIA_RPC_URL --broadcast -vvvv",
    "sepolia:deploy:deploy-protocol": "source .env && forge script script/sepolia/DeployProtocol.s.sol --rpc-url $SEPOLIA_RPC_URL --verify --etherscan-api-key $ETHERSCAN_KEY --broadcast -vvvv",
    "whitelist-collateral-assets": "source .env && forge script script/separate/WhitelistCollateralAssets.s.sol --rpc-url $RPC_URL --verify --etherscan-api-key $ETHERSCAN_KEY --broadcast -vvvv",
    "deploy:sandbox-controller": "source .env && forge script script/separate/DeploySandboxController.s.sol --rpc-url $RPC_URL --verify --etherscan-api-key $ETHERSCAN_KEY --broadcast -vvvv",
    "deploy:config-controller-implementation": "source .env && forge script script/separate/DeployConfigControllerImplementation.s.sol --rpc-url $RPC_URL --verify --etherscan-api-key $ETHERSCAN_KEY --broadcast -vvvv",
    "deploy:config-controller-factory": "source .env && forge script script/separate/DeployConfigControllerFactory.s.sol --rpc-url $RPC_URL --verify --etherscan-api-key $ETHERSCAN_KEY --broadcast -vvvv",
    "deploy:comet-implementation": "source .env && forge script script/separate/DeployCometImplementation.s.sol --rpc-url $RPC_URL --verify --etherscan-api-key $ETHERSCAN_KEY --broadcast -vvvv",
    "deploy:sandbox-comet-factory": "source .env && forge script script/separate/DeploySandboxCometFactory.s.sol --rpc-url $RPC_URL --verify --etherscan-api-key $ETHERSCAN_KEY --broadcast -vvvv",
    "virtual-sepolia:deploy:price-feeds": "source .env && forge script script/sepolia/DeployPriceFeeds.s.sol --rpc-url $TENDERLY_VIRTUAL_TESTNET_RPC --etherscan-api-key $TENDERLY_ACCESS_KEY --verify --verifier custom --verifier-url $TENDERLY_VERIFIER_URL --broadcast --slow -vvvv",
    "virtual-sepolia:change-price-feeds": "source .env && forge script script/sepolia/ChangePriceFeeds.s.sol --rpc-url $TENDERLY_VIRTUAL_TESTNET_RPC --etherscan-api-key $TENDERLY_ACCESS_KEY --verify --verifier custom --verifier-url $TENDERLY_VERIFIER_URL --broadcast --slow -vvvv",
    "virtual-sepolia:deploy:sandbox-controller": "source .env && forge script script/separate/DeploySandboxController.s.sol --rpc-url $TENDERLY_VIRTUAL_TESTNET_RPC --etherscan-api-key $TENDERLY_ACCESS_KEY --verify --verifier custom --verifier-url $TENDERLY_VERIFIER_URL --broadcast --slow -vvvv",
    "virtual-sepolia:deploy:config-controller-implementation": "source .env && forge script script/separate/DeployConfigControllerImplementation.s.sol --rpc-url $TENDERLY_VIRTUAL_TESTNET_RPC --etherscan-api-key $TENDERLY_ACCESS_KEY --verify --verifier custom --verifier-url $TENDERLY_VERIFIER_URL --broadcast --slow -vvvv",
    "virtual-sepolia:deploy:config-controller-factory": "source .env && forge script script/separate/DeployConfigControllerFactory.s.sol --rpc-url $TENDERLY_VIRTUAL_TESTNET_RPC --etherscan-api-key $TENDERLY_ACCESS_KEY --verify --verifier custom --verifier-url $TENDERLY_VERIFIER_URL --broadcast --slow -vvvv",
    "virtual-sepolia:deploy:comet-implementation": "source .env && forge script script/separate/DeployCometImplementation.s.sol --rpc-url $TENDERLY_VIRTUAL_TESTNET_RPC --etherscan-api-key $TENDERLY_ACCESS_KEY --verify --verifier custom --verifier-url $TENDERLY_VERIFIER_URL --broadcast --slow -vvvv",
    "virtual-sepolia:deploy:sandbox-comet-factory": "source .env && forge script script/separate/DeploySandboxCometFactory.s.sol --rpc-url $TENDERLY_VIRTUAL_TESTNET_RPC --etherscan-api-key $TENDERLY_ACCESS_KEY --verify --verifier custom --verifier-url $TENDERLY_VERIFIER_URL --broadcast --slow -vvvv",
    "virtual-sepolia:whitelist-collateral-assets": "source .env && forge script script/separate/WhitelistCollateralAssets.s.sol --rpc-url $TENDERLY_VIRTUAL_TESTNET_RPC --etherscan-api-key $TENDERLY_ACCESS_KEY --verify --verifier custom --verifier-url $TENDERLY_VERIFIER_URL --broadcast --slow -vvvv",
    "virtual-sepolia:deploy:market:usdc": "source .env && forge script script/sepolia/CreateUSDCMarket.s.sol --rpc-url $TENDERLY_VIRTUAL_TESTNET_RPC --etherscan-api-key $TENDERLY_ACCESS_KEY --verify --verifier custom --verifier-url $TENDERLY_VERIFIER_URL --broadcast --slow -vvvv",
    "virtual-sepolia:deploy:market:usdc2": "source .env && forge script script/sepolia/CreateUSDCMarket2.s.sol --rpc-url $TENDERLY_VIRTUAL_TESTNET_RPC --etherscan-api-key $TENDERLY_ACCESS_KEY --verify --verifier custom --verifier-url $TENDERLY_VERIFIER_URL --broadcast --slow -vvvv",
    "virtual-sepolia:deploy:market:wbtc": "source .env && forge script script/sepolia/CreateWBTCMarket.s.sol --rpc-url $TENDERLY_VIRTUAL_TESTNET_RPC --etherscan-api-key $TENDERLY_ACCESS_KEY --verify --verifier custom --verifier-url $TENDERLY_VERIFIER_URL --broadcast --slow -vvvv",
    "virtual-sepolia:deploy:market:weth": "source .env && forge script script/sepolia/CreateWETHMarket.s.sol --rpc-url $TENDERLY_VIRTUAL_TESTNET_RPC --etherscan-api-key $TENDERLY_ACCESS_KEY --verify --verifier custom --verifier-url $TENDERLY_VERIFIER_URL --broadcast --slow -vvvv",
    "virtual-sepolia:market-simulation": "source .env && forge script script/sepolia/MarketSimulation.s.sol --rpc-url $TENDERLY_VIRTUAL_TESTNET_RPC --broadcast --slow -vvvv"
  },
  "author": "Compound Finance",
  "license": "UNLICENSED",
  "dependencies": {
    "@openzeppelin/contracts": "file:lib/openzeppelin-contracts/contracts",
    "chai": "^5.2.1",
    "hardhat-docgen": "^1.3.0",
    "hardhat-preprocessor": "^0.1.5",
    "solc": "^0.8.28",
    "solidity-docgen": "^0.6.0-beta.36"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.0.0",
    "@nomicfoundation/hardhat-foundry": "^1.1.3",
    "@nomicfoundation/hardhat-network-helpers": "^1.0.0",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@nomiclabs/hardhat-ethers": "^2.0.4",
    "@nomiclabs/hardhat-etherscan": "3.1.7",
    "@typechain/ethers-v5": "^8.0.2",
    "@typechain/hardhat": "^3.0.0",
    "@types/chai": "^5.2.2",
    "@types/chai-as-promised": "^8.0.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.1.0",
    "@typescript-eslint/eslint-plugin": "5.62.0",
    "@typescript-eslint/parser": "5.62.0",
    "dotenv": "^17.2.1",
    "eslint": "8.56.0",
    "ethers": "^5.7.2",
    "hardhat": "^2.22.14",
    "hardhat-chai-matchers": "https://github.com/jflatow/hardhat/releases/download/viaIR/nomicfoundation-hardhat-chai-matchers-v1.0.4.tgz",
    "hardhat-change-network": "^0.0.7",
    "hardhat-contract-sizer": "^2.10.0",
    "hardhat-gas-reporter": "^1.0.7",
    "mocha-multi-reporters": "^1.5.1",
    "prettier": "^3.6.2",
    "prettier-plugin-solidity": "2.1.0",
    "solhint": "^6.0.0",
    "solidity-coverage": "^0.8.16",
    "ts-node": "^10.9.2",
    "typechain": "^6.0.2",
    "typescript": "5.1.6"
  },
  "repository": "git@github.com:woof-sandbox/sandbox.git",
  "resolutions": {
    "mocha": "^9.1.3",
    "prettier": "2.8.8"
  }
}
